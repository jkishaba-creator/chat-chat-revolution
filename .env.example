# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#   cp .env.example .env
#   npm run live:youtube

# off | mock | youtube
CHAT_SOURCE=youtube

# Google Cloud Console > APIs & Services > Credentials > API key,
# with "YouTube Data API v3" enabled on the project.
YOUTUBE_API_KEY=

# The live broadcast to read chat from. Accepts a bare video ID or any
# watch / live / youtu.be URL. This is the VIDEO, not the channel.
YOUTUBE_VIDEO=

# Self-imposed daily ceiling, below the 10,000 unit default allocation.
YOUTUBE_QUOTA_BUDGET=9000
